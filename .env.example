# Base de données PostgreSQL (Neon, Railway Postgres, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret de session (générer une longue chaîne aléatoire)
SESSION_SECRET=changez-moi-avec-une-chaine-aleatoire

# URL publique du site (utilisée pour les liens d'invitation et les emails)
APP_URL=https://votre-domaine.up.railway.app

# Identifiants admin (créés automatiquement au premier démarrage)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-moi

# Envoi d'emails de confirmation RSVP (optionnel — https://resend.com)
RESEND_API_KEY=
# Expéditeur des emails (domaine vérifié sur Resend)
EMAIL_FROM=Glodie & Samuel <invitations@votre-domaine.com>

# Port local (Railway fournit PORT automatiquement)
PORT=5173
